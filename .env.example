# OpenAI and Gemini are not used. PubMed evidence is retrieved through NCBI E-utilities.
BIOFC_CLAIM_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v1.1-all-33
BIOFC_CLASSIFIER_DIR=artifacts/multisource_classifier

# NCBI requires a contact email. An API key is optional for normal FYP usage.
BIOFC_NCBI_EMAIL=your-email@example.com
BIOFC_NCBI_API_KEY=

# Runtime tuning
BIOFC_WHISPER_MODEL=small
BIOFC_OCR_ENGINE=paddle
BIOFC_FRAME_INTERVAL_SECONDS=1.0
BIOFC_MAX_CLAIMS=5
BIOFC_MAX_ATOMIC_CLAIMS=12
BIOFC_PUBMED_RESULTS=3
BIOFC_PUBMED_CANDIDATES=50
BIOFC_PUBMED_QUERIES=3
BIOFC_MIN_EVIDENCE_RELEVANCE=0.30
BIOFC_MIN_EVIDENCE_TERM_COVERAGE=0.20
BIOFC_LOG_LEVEL=INFO
